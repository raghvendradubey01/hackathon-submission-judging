# Dogfood Platform Environment Configuration
# Automatically loaded by Docker Compose and local Node.js environment

NODE_ENV=development
PORT=3000

# PostgreSQL Connection (local docker service)
DATABASE_URL="postgresql://raptor:raptorpass@localhost:5432/dogfood_db?schema=public"
POSTGRES_USER="raptor"
POSTGRES_PASSWORD="raptorpass"
POSTGRES_DB="dogfood_db"

# JWT Secret for local self-hosted authentication
JWT_SECRET="raptors_jwt_production_secret_key_dogfood_2026_super_secure_random"

# Offline hermetic mode flag
OFFLINE_MODE=true
