// Prisma Schema for Dogfood 2026 - Hackathon Raptors Submission and Judging Platform
// Designed for PostgreSQL in production and offline-first single container deployments.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PARTICIPANT
  JUDGE
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  REGISTRATION
  SUBMISSION
  JUDGING
  VOTING
  RESULTS
  ARCHIVED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LOCKED
  UNDER_REVIEW
  FINAL
}

enum TeamRole {
  CAPTAIN
  MEMBER
}

enum AssignmentStatus {
  PENDING
  COMPLETED
}

enum VoteType {
  UPVOTE
  QUADRATIC
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(PARTICIPANT)
  organization  String
  bio           String?
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  teamMembers   TeamMember[]
  submissions   Submission[]   @relation("SubmissionAuthor")
  assignments   JudgeAssignment[] @relation("JudgeAssignments")
  scores        Score[]        @relation("JudgeScores")
  votes         CommunityVote[]
  comments      Comment[]
  auditLogs     AuditLog[]     @relation("ActorLogs")

  @@index([role])
  @@index([email])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Event {
  id                    String       @id @default(uuid())
  name                  String
  slug                  String       @unique
  edition               String       @default("2026.1")
  tagline               String
  description           String
  organizerName         String       @default("Hackathon Raptors CIC")
  status                EventStatus  @default(SUBMISSION)
  registrationStartsAt  DateTime
  registrationEndsAt    DateTime
  submissionStartsAt    DateTime
  submissionEndsAt      DateTime
  judgingStartsAt       DateTime
  judgingEndsAt         DateTime
  votingStartsAt        DateTime
  votingEndsAt          DateTime
  resultsEmbargoed      Boolean      @default(true)
  communityVotingEnabled Boolean     @default(true)
  minTeamSize           Int          @default(1)
  maxTeamSize           Int          @default(4)
  totalPrizePool        Int          @default(250000)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  tracks                Track[]
  prizes                Prize[]
  teams                 Team[]
  submissions           Submission[]
  rubrics               Rubric[]
  assignments           JudgeAssignment[]

  @@index([status])
}

model Track {
  id          String       @id @default(uuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String
  prizeAmount Int          @default(50000)
  submissions Submission[]

  @@index([eventId])
}

model Prize {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  amount      Int
  rank        Int?
  description String

  @@index([eventId])
}

model Team {
  id          String       @id @default(uuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String       @unique
  tagline     String
  inviteCode  String       @unique
  captainId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members     TeamMember[]
  submissions Submission[]

  @@index([eventId])
  @@index([inviteCode])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model Submission {
  id                String           @id @default(uuid())
  eventId           String
  event             Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamId            String
  team              Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  trackId           String
  track             Track            @relation(fields: [trackId], references: [id])
  authorId          String?
  author            User?            @relation("SubmissionAuthor", fields: [authorId], references: [id])
  title             String
  tagline           String
  description       String
  problemStatement  String?
  solution          String?
  repoUrl           String
  demoVideoUrl      String?
  liveUrl           String?
  techStack         String[]
  status            SubmissionStatus @default(DRAFT)
  versionNumber     Int              @default(1)
  submittedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  versions          SubmissionVersion[]
  assignments       JudgeAssignment[]
  scores            Score[]
  normalizedScore   NormalizedScore?
  votes             CommunityVote[]
  comments          Comment[]
  certificates      Certificate[]

  @@index([eventId])
  @@index([teamId])
  @@index([status])
  @@index([trackId])
}

model SubmissionVersion {
  id            String     @id @default(uuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  versionNumber Int
  title         String
  description   String
  repoUrl       String
  snapshotJson  Json
  createdAt     DateTime   @default(now())

  @@unique([submissionId, versionNumber])
}

model Rubric {
  id          String            @id @default(uuid())
  eventId     String
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  criteria    RubricCriterion[]
  createdAt   DateTime          @default(now())
}

model RubricCriterion {
  id          String       @id @default(uuid())
  rubricId    String
  rubric      Rubric       @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  name        String
  description String
  weight      Float        // Must sum to 1.00
  minPoints   Int          @default(0)
  maxPoints   Int          @default(100)
  scoreValues ScoreValue[]

  @@index([rubricId])
}

model JudgeAssignment {
  id            String           @id @default(uuid())
  eventId       String
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judgeId       String
  judge         User             @relation("JudgeAssignments", fields: [judgeId], references: [id], onDelete: Cascade)
  submissionId  String
  submission    Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  status        AssignmentStatus @default(PENDING)
  assignedAt    DateTime         @default(now())
  completedAt   DateTime?
  scores        Score[]

  @@unique([judgeId, submissionId])
  @@index([judgeId])
  @@index([submissionId])
}

model Score {
  id              String           @id @default(uuid())
  assignmentId    String?
  assignment      JudgeAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  judgeId         String
  judge           User             @relation("JudgeScores", fields: [judgeId], references: [id], onDelete: Cascade)
  submissionId    String
  submission      Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  weightedTotal   Float
  feedbackNote    String?
  submittedAt     DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  values          ScoreValue[]

  @@unique([judgeId, submissionId])
  @@index([submissionId])
  @@index([judgeId])
}

model ScoreValue {
  id          String          @id @default(uuid())
  scoreId     String
  score       Score           @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  points      Float

  @@unique([scoreId, criterionId])
}

model NormalizedScore {
  id                String     @id @default(uuid())
  submissionId      String     @unique
  submission        Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  rawMean           Float
  zScoreMean        Float
  minMaxScore       Float
  bradleyTerryScore Float
  finalScore        Float
  rawRank           Int
  normalizedRank    Int
  rankDelta         Int
  computedAt        DateTime   @default(now())
}

model CommunityVote {
  id            String     @id @default(uuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  voterId       String
  voter         User       @relation(fields: [voterId], references: [id], onDelete: Cascade)
  voteType      VoteType   @default(UPVOTE)
  creditsSpent  Int        @default(1)
  fingerprint   String
  createdAt     DateTime   @default(now())

  @@index([submissionId])
  @@index([voterId])
}

model Comment {
  id            String     @id @default(uuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId      String
  author        User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content       String
  createdAt     DateTime   @default(now())

  @@index([submissionId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  actor       User     @relation("ActorLogs", fields: [actorId], references: [id], onDelete: Cascade)
  actorName   String
  actorRole   Role
  action      String
  targetType  String
  targetId    String
  details     String
  ipAddress   String   @default("127.0.0.1")
  timestamp   DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([timestamp])
}

model Certificate {
  id            String     @id @default(uuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  recipientName String
  awardTitle    String
  sha256Digest  String     @unique
  signature     String
  issuedAt      DateTime   @default(now())

  @@index([sha256Digest])
}

model Webhook {
  id            String    @id @default(uuid())
  url           String
  events        String[]
  secret        String
  enabled       Boolean   @default(true)
  lastTriggered DateTime?
  lastStatus    Int?
  createdAt     DateTime  @default(now())
}
